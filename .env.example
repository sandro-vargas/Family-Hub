# Supabase (Optional - ohne Eintrag läuft die App im lokalen Persistenz-Modus)
NEXT_PUBLIC_SUPABASE_URL=https://dein-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dein-supabase-anon-key

# Google Gemini API (Für KI-Essensplanung & KI-Freizeitplaner Zürcher Oberland)
GEMINI_API_KEY=dein-google-ai-studio-key

# Bidirektionale Google Kalender Synchronisation (2-Wege-Sync mit bestehendem Familienkalender)
GOOGLE_CALENDAR_ID=primary
# Variante A (Empfohlen für Familien-App & iPad ohne Login-Ablauf): Google Cloud Service Account
GOOGLE_SERVICE_ACCOUNT_EMAIL=dein-service-account@dein-projekt.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Variante B (Alternativ): OAuth 2.0 Refresh Token
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

